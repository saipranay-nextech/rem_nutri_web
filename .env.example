# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
#   cp .env.example .env.local
# `.env.local` is git-ignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Sanity CMS (required for the blog) ------------------------------------
# Find these at https://www.sanity.io/manage -> your project -> Project ID.
# They are also set as environment variables on the Vercel project.
# Without NEXT_PUBLIC_SANITY_PROJECT_ID the site still runs, but blog posts
# will be empty and a warning is printed to the server console.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-14

# --- Newsletter: Google Sheets (optional) -----------------------------------
# If unset, subscribers fall back to the local file data/subscribers.json.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Outbound email ---------------------------------------------------------
# Mailbox used for all outbound mail (contact, careers, newsletter, health
# assessment). EMAIL_PASSWORD must be a provider app password, never the
# account password.
EMAIL_USER=
EMAIL_PASSWORD=

# SMTP host/port. The code falls back to smtp.zoho.in:465, but the project's
# mailboxes are on Google Workspace (MX -> SMTP.GOOGLE.COM), so set these
# explicitly to match whichever mailbox EMAIL_USER actually is:
#
#   Google Workspace / Gmail : smtp.gmail.com  port 465
#     Requires a 16-char App Password from https://myaccount.google.com/apppasswords
#     (2-Step Verification must be enabled). Account passwords are rejected with
#     "534-5.7.9 Application-specific password required".
#
#   Zoho India               : smtp.zoho.in    port 465
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# Optional: where team/support notifications go. Defaults to EMAIL_USER,
# i.e. the site emails itself. Set this to route them to support@ instead.
# EMAIL_TO=support@remnutri.com

# --- Public site origin -----------------------------------------------------
# Used for links and images inside emails. Defaults to the Vercel URL.
# NEXT_PUBLIC_SITE_URL=https://www.remnutri.com
